{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "force": false,
      "segments": [
        {
          "type": "root",
          "style": "diamond",
          "foreground": "#000000",
          "background": "#ffe95c",
          "template": " \uf0e7 ",
          "powerline_symbol": "\ue0b0",
          "trailing_diamond": "\ue0b0"
        },
        {
          "type": "os",
          "style": "diamond",
          "foreground": "#ffffff",
          "background": "#47a1e6",
          "template": " {{ if .WSL }}WSL at {{ end }}{{ .Icon }} ",
          "powerline_symbol": "\ue0b0",
          "options": {}
        },
        {
          "type": "path",
          "style": "powerline",
          "foreground": "#e4e4e4",
          "background": "#215497",
          "template": " \uf07c {{ .Path }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_icon": "..."
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "foreground": "#000000",
          "background": "#4e9a06",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#c4a000{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#f26d50{{ end }}",
            "{{ if gt .Ahead 0 }}#89d1dc{{ end }}",
            "{{ if gt .Behind 0 }}#4e9a06{{ end }}"
          ],
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "branch_icon": "\uf126 ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        },
        {
          "type": "project",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "template": " \ueb30 {{ .Name }}{{ if .Version }} {{ .Version }}{{ end }} ",
          "foreground": "#ffffff",
          "background": "#cd1d96",
          "options": {}
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "node",
          "style": "powerline",
          "foreground": "#ffffff",
          "background": "#5fa04e",
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "options": {
            "fetch_version": true
          }
        },
        {
          "type": "npm",
          "style": "powerline",
          "foreground": "#ffffff",
          "background": "#cb0000",
          "template": " \ue71e {{ .Full }} ",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true
        },
        {
          "type": "react",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "template": " \ue7ba {{ .Full }} ",
          "foreground": "#ffffff",
          "background": "#087ea4",
          "invert_powerline": true
        },
        {
          "type": "python",
          "style": "powerline",
          "foreground": "#111111",
          "background": "#ffd343",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "options": {
            "display_mode": "files",
            "fetch_virtual_env": false
          }
        },
        {
          "type": "java",
          "style": "powerline",
          "foreground": "#000000",
          "background": "#ffa424",
          "template": " \ue738 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true
        },
        {
          "type": "kotlin",
          "style": "powerline",
          "foreground": "#ffffff",
          "background": "#b818de",
          "template": " \ue81b {{ .Full }} ",
          "powerline_symbol": "\ue0b2",
          "leading_diamond": "\ue0b2",
          "invert_powerline": true
        },
        {
          "type": "php",
          "style": "powerline",
          "foreground": "#000000",
          "background": "#8c9bd6",
          "template": " \ue73d {{ .Full }} ",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true
        },
        {
          "type": "dotnet",
          "style": "powerline",
          "foreground": "#ffffff",
          "background": "#512bd4",
          "template": " \ue648 .NET {{ if .Unsupported }}\uf071{{ else }}{{ .Full }}{{ end }} ",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true
        },
        {
          "type": "rust",
          "style": "powerline",
          "foreground": "#000000",
          "background": "#f74c00",
          "template": " \ue7a8 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true
        },
        {
          "type": "go",
          "style": "powerline",
          "foreground": "#111111",
          "background": "#00acd7",
          "template": " \ue627 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "options": {
            "fetch_version": true
          }
        },
        {
          "type": "ruby",
          "style": "powerline",
          "foreground": "#ffffff",
          "background": "#AE1401",
          "template": " \ue791 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "options": {
            "display_mode": "files",
            "fetch_version": true
          }
        },
        {
          "type": "lua",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "template": " \ue620 {{ .Full }} ",
          "foreground": "#ffffff",
          "background": "#00007f",
          "invert_powerline": true
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "foreground": "#000000",
          "background": "#c4a000",
          "template": " \uf252 {{ .FormattedMs }} ",
          "powerline_symbol": "\ue0b2",
          "leading_diamond": "\ue0b2",
          "invert_powerline": true
        },
        {
          "type": "status",
          "style": "powerline",
          "foreground": "#d3d7cf",
          "background": "#000000",
          "background_templates": [
            "{{ if gt .Code 0 }}#cc2222{{ end }}"
          ],
          "template": " {{ if gt .Code 0 }}{{ reason .Code }}{{ else }}\uf42e{{ end }} ",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "options": {
            "always_enabled": true
          }
        },
        {
          "type": "battery",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "template": " {{ if not .Error }}{{ .Icon }}\ueb2d {{ .Percentage }}%{{ end }}{{ .Error }} ",
          "foreground": "#000000",
          "background": "#25c14c",
          "invert_powerline": true
        },
        {
          "type": "sysinfo",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "template": " \uf4bc {{ round .PhysicalPercentUsed .Precision }}% ",
          "foreground": "#ffffff",
          "background": "#2646e3",
          "invert_powerline": true
        },
        {
          "type": "time",
          "style": "diamond",
          "foreground": "#000000",
          "background": "#ffffff",
          "template": " \uf017 {{ .CurrentDate | date .Format }} ",
          "powerline_symbol": "\ue0b2",
          "trailing_diamond": "\ue0b0",
          "invert_powerline": true,
          "options": {
            "time_format": "15:04:05"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "#00aaff",
          "template": "\u276f",
          "powerline_symbol": "\ue0b0",
          "options": {
            "always_enabled": true
          }
        }
      ]
    }
  ]
}
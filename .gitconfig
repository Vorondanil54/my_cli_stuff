[core]
	editor = micro
	# \"C:\\Users\\shush\\AppData\\Local\\Programs\\Microsoft VS Code\\bin\\code\" --wait
	pager = delta
	safecrlf = false

[user]
	name = Vorondanil54
	email = voronchihin.danill@yandex.ru

[include]
	path = ~/.config/delta/themes.gitconfig

[init]
	defaultbranch = main

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true  # use n and N to move between diff sections
	dark = true      # or light = true, or omit for auto-detection
	true-color = always
	features = colibri
	line-numbers = true
	side-by-side = true

[merge]
	conflictStyle = zdiff3

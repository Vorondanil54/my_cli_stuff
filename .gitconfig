[core]
	editor = micro
	# \"C:\\Users\\shush\\AppData\\Local\\Programs\\Microsoft VS Code\\bin\\code\" --wait
	pager = delta
	safecrlf = false

# I removed [user] field from this copy of my gitconfig 'cause I through it will be good to not spoil my user and email options

[include]
	path = ~/.config/delta/themes.gitconfig

[init]
	defaultbranch = main

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true  # use n and N to move between diff sections
	dark = true      # or light = true, or omit for auto-detection
	true-color = always
	features = colibri
	line-numbers = true
	side-by-side = true

[merge]
	conflictStyle = zdiff3

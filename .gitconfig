[core]
	editor = micro
	# \"C:\\Users\\shush\\AppData\\Local\\Programs\\Microsoft VS Code\\bin\\code\" --wait
	pager = delta
	safecrlf = false

[init]
	defaultbranch = main

[include]
	path = ~/.config/delta/themes.gitconfig

#[pager]
#	diff = delta --tui
#	show = delta --tui
#	log = delta --tui

#[sequence]
#	editor = delta --tui sequence-editor

# Uncomment [user] filed below and paste your username and email in their fields
#[user]
#	name = YourNameHere
#	email = youremail@domain.com

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true  # use n and N to move between diff sections
	dark = true      # or light = true, or omit for auto-detection
	true-color = always
	features = colibri
	syntax-theme= "Catppuccin Macchiato"
	line-numbers = true
	side-by-side = true

[delta-tui]
	file-header = stat  # Head each file with its `git diff --stat` row.
	start-folded = true # Open every patch with its files folded.

[merge]
	conflictStyle = zdiff3
